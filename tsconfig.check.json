{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "index.js",
    "host/**/*.js",
    "tests/**/*.js",
    "scripts/**/*.mjs",
    "types/**/*.d.ts"
  ]
}
